        <mxCell id="gateway-watch-label" value="Consul Catalog / HTTP :8500&lt;br&gt;watch; только status = passing" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontColor=#27866D;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="500" y="791.0" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="register-label" value="API → Consul: регистрация и удаление&lt;br&gt;Общее имя pymongo-api, уникальные ID и адреса" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=19;fontColor=#8056A0;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="910.0" width="640" height="70" as="geometry" />
        </mxCell>
        <mxCell id="health-label" value="Consul → каждый API&lt;br&gt;GET /health :8080" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=19;fontColor=#27866D;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1130" y="783.0" width="450" height="65" as="geometry" />
        </mxCell>
        <mxCell id="balancing-label" value="HTTP :8080&lt;br&gt;доступные API" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontColor=#245D91;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="598" y="1217.0" width="177" height="65" as="geometry" />
        </mxCell>
        <mxCell id="db-label" value="Каждый API → mongos :27017&lt;br&gt;Промах кеша / запись" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontColor=#245D91;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1220" y="1060.0" width="425" height="65" as="geometry" />
        </mxCell>
        <mxCell id="pool-caption" value="Stateless · единый образ приложения" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontColor=#425466;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="812" y="1624.0" width="330" height="32" as="geometry" />
        </mxCell>
        <mxCell id="cache-label" value="Каждый API → Redis: GET / SET / DEL&lt;br&gt;Общий кеш; сброс после записи.&lt;br&gt;При сбое Redis — чтение через mongos." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontColor=#B84242;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="785" y="1700.0" width="425" height="95" as="geometry" />
        </mxCell>
        <mxCell id="discovery-notes" value="КАК МЕНЯЕТСЯ СОСТАВ API&lt;br&gt;1. Новый инстанс регистрирует свой ID и адрес.&lt;br&gt;2. Consul проверяет готовность приложения.&lt;br&gt;3. Gateway включает только passing-инстансы.&lt;br&gt;4. critical / удалённый адрес выходит из балансировки.&lt;br&gt;Обновления применяются с задержкой обнаружения." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=19;fontColor=#425466;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="1490.0" width="670" height="210" as="geometry" />
        </mxCell>
        <mxCell id="replica-notes" value="MongoDB: три независимые группы репликации.&lt;br&gt;В каждой: 1 primary + 2 secondary; роли меняются при выборах.&lt;br&gt;Шесть узлов данных + три узла метаданных.&lt;br&gt;Состав кластеров и служебные связи сохранены из варианта 04." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontColor=#425466;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1680" y="1690" width="820" height="125" as="geometry" />
        </mxCell>
        <mxCell id="legend-data" value="Сплошные стрелки: бирюзовый — статика CDN; синий — API / MongoDB; красный — Redis; оранжевый — метаданные." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=19;fontColor=#425466;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="1900" width="2460" height="35" as="geometry" />
        </mxCell>
        <mxCell id="legend-control" value="Пунктир: зелёный — discovery и health checks; фиолетовый у API — регистрация, внутри MongoDB — репликация / HB." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontColor=#425466;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="1940" width="2460" height="35" as="geometry" />
        </mxCell>
        <mxCell id="legend-monitor" value="Серый пунктир — мониторинг secondary со стороны mongos. Ответы идут по тем же соединениям; пересечение линий не означает соединение." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontColor=#425466;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="1980" width="2460" height="35" as="geometry" />
        </mxCell>
        <mxCell id="scope-note" value="План: Gateway, Consul, CDN и static-origin ещё не развёрнуты. Шардирование, репликация и Redis реализованы в заданиях 2–4." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontColor=#425466;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="2020" width="2460" height="35" as="geometry" />
        </mxCell>
        <mxCell id="scope-mongo" value="На схеме 20 сервисных компонентов, включая 3 точки присутствия одного CDN, и 3 группы пользователей. Подробности — в README." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontColor=#425466;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="2055" width="2460" height="30" as="geometry" />
        </mxCell>
        <mxCell id="title" value="05  /  CDN в нескольких регионах" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=32;fontColor=#152B40;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="28" width="2480" height="48" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Публичная статика доставляется через CDN; при промахе кеша CDN получает файлы из общего origin-хранилища." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontColor=#526476;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="82" width="2480" height="35" as="geometry" />
        </mxCell>
