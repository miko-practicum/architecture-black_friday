          <mxGeometry as="geometry" x="80" y="650" width="620" height="70" />
        </mxCell>
        <mxCell id="redis-commands" value="GET → hit: ответ из кеша; miss: запрос в MongoDB.&lt;br&gt;SET + TTL после чтения; DEL после записи." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;resizable=1;fontSize=16;fontColor=#B84242;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="185" y="726" width="575" height="65" />
        </mxCell>
        <mxCell id="cache-notes" value="Cache-aside: кешем управляет pymongo-api.&lt;br&gt;MongoDB остаётся источником данных.&lt;br&gt;При сбое Redis — чтение через mongos." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;resizable=1;fontSize=17;fontColor=#425466;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="915" width="650" height="100" />
        </mxCell>
        <mxCell id="legend-main" value="Синий — запросы данных; оранжевый — метаданные; фиолетовый — репликация и heartbeat (HB)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;resizable=1;fontSize=17;fontColor=#425466;fontStyle=0;" vertex="1" parent="1">
