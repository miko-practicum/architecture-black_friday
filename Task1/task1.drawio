          <mxGeometry as="geometry" x="80" y="650" width="620" height="70" />
        </mxCell>
        <mxCell id="next-stage" value="СЛЕДУЮЩИЙ ЭТАП&lt;br&gt;Добавить Redis для кеширования чтений приложения.&lt;br&gt;Сохранить два шарда и маршрутизацию через mongos." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;resizable=1;fontSize=18;fontColor=#425466;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="805" width="630" height="120" />
        </mxCell>
