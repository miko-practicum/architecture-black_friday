          <mxGeometry as="geometry" x="60" y="1070" width="1660" height="40" />
        </mxCell>
        <mxCell id="legend-monitor" value="Серый пунктир — обнаружение и мониторинг secondary со стороны mongos; ответы идут по тем же соединениям." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;resizable=1;fontSize=16;fontColor=#425466;fontStyle=0;" vertex="1" parent="1">
